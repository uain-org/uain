[Unit]
Description=Publish the UAIN native proof age for monitoring (read-only)

[Service]
Type=oneshot
User=root
UMask=0022
ExecStart=/usr/bin/python3 -I /opt/uain-proof-age/proof-age.py
MemoryMax=64M
CPUQuota=10%
TasksMax=8
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/uain-proof-age /var/lib/node_exporter/textfile
PrivateTmp=true
