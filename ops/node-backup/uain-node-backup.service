[Unit]
Description=Encrypted UAIN node backups with cross-host and off-site verification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/uain-node-backup run
ExecStopPost=-/usr/bin/systemctl stop uain-node-backup-capture.service
ExecStopPost=/usr/bin/python3 /opt/uain-node-backup/node.py recover
TimeoutStartSec=50min
TimeoutStopSec=120
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitCORE=0
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

