{
  "schema": "uain-dev-components-v1",
  "description": "Declarative component and dependency map for shadow impact classification (plan P2). It never suppresses the current gates: deploy.yml and pr-checks.yml still run their full suites until repository policy is amended.",
  "mode": "shadow",
  "currentGates": "Since 9 November 2026: the pre-push npm run check (ops/check.sh) runs the scoped suites on uain-app-1; deploy.yml only scopes, builds and rolls out; the nightly e2e.yml reruns the routine suites.",
  "checks": {
    "docs-validation": {
      "command": "Links, format and secret scan of the changed documents",
      "evidence": "Documentation validation; no runtime deployment"
    },
    "docs-data": {
      "command": "node -e 'JSON.parse(require(\"fs\").readFileSync(process.argv[1]))' <file> for each changed docs JSON record",
      "evidence": "Machine-readable record parses; consumers are mapped separately"
    },
    "docs-executable": {
      "command": "node --check / python3 -m py_compile on changed docs scripts",
      "evidence": "Docs build scripts parse; they are inputs, not prose"
    },
    "policy-review": {
      "command": "Human review of the governing policy change against docs/federation and CLAUDE.md",
      "evidence": "Reviewed policy amendment recorded in CHANGELOG.md"
    },
    "lint": {
      "command": "npm run lint",
      "evidence": "oxlint clean"
    },
    "dev-tools": {
      "command": "node --test ops/dev/*.test.mjs",
      "evidence": "Component map and timing tools pass"
    },
    "site-build": {
      "command": "ops/remote-test/run.sh --suite site",
      "suite": "site",
      "evidence": "Typecheck and site build (includes pilot build and the frozen client release check)"
    },
    "pilot-suite": {
      "command": "ops/remote-test/run.sh --suite pilot",
      "suite": "pilot",
      "evidence": "Connection server suite, both database threads, three shards each"
    },
    "pilot-research": {
      "command": "ops/remote-test/run.sh --suite pilot (research job: sudo uain-ci-run <workspace> research <thread>)",
      "suite": "research",
      "evidence": "Research vectors and retrieval contract, both threads"
    },
    "pilot-reset": {
      "command": "sudo uain-ci-run <workspace> reset <thread>",
      "suite": "reset",
      "evidence": "Complete schema reset and archive restore, both threads"
    },
    "admin-contract": {
      "command": "node --test services/pilot/test/admin-*.test.mjs (after npm run build:pilot)",
      "evidence": "Admin wire contract consumed by the separate super-admin repository"
    },
    "waitlist-tests": {
      "command": "npm --prefix apps/waitlist-dashboard test",
      "evidence": "Waitlist dashboard tests"
    },
    "baink-tests": {
      "command": "npm --prefix apps/baink test && npm --prefix apps/baink run build",
      "evidence": "BAINK suite and root and /baink/ preview builds"
    },
    "baink-deploy": {
      "command": "python3 -m unittest discover -s apps/baink/deploy -p 'test_*.py'",
      "evidence": "BAINK packaging, activation and routing installers"
    },
    "qualification-tests": {
      "command": "node --test ops/qualification/*.test.mjs",
      "evidence": "Qualification harnesses that import BAINK and chain client modules"
    },
    "holder-tests": {
      "command": "node --test apps/baink/review-broker/*.test.mjs",
      "evidence": "Private payment reviewer and review broker (moved out of the retired Docker holder)"
    },
    "reviewer-tests": {
      "command": "node --test apps/baink/review-service/*.test.mjs services/central-reviewer/test/*.test.mjs && python3 -m unittest discover -s ops/custody -p 'test_central_reviewer*.py'",
      "evidence": "Independent review and root custody boundaries"
    },
    "organizations-tests": {
      "command": "npm run test:organizations",
      "evidence": "Project organizations, fund manager and custody organization tests"
    },
    "custody-python": {
      "command": "python3 -m unittest discover -s ops/custody -p 'test_*.py'",
      "evidence": "Custody, treasury and privileged execution helpers"
    },
    "codec-contract": {
      "command": "node --test chain/client/*.test.mjs apps/baink/integrations/*.test.mjs apps/baink/web/native-*.test.mjs",
      "evidence": "Wallet, holder and native codecs agree across chain client, BAINK web and holder"
    },
    "central-policy-cross": {
      "command": "cd chain && go test ./federation -run 'Central|CrossPolicy'; node --test apps/baink/test/funding-policy.test.mjs services/fund-manager/test/*.test.mjs; python3 -m unittest discover -s ops/custody -p 'test_central_*.py'",
      "evidence": "Central earning/funding policy identical across Go, JavaScript and Python"
    },
    "native-chain": {
      "command": "ops/remote-test/run.sh --suite native-chain (chain.yml native-chain job)",
      "suite": "native-chain",
      "evidence": "Native race, persistence, gas, signatures and two-node smoke"
    },
    "private-exchange": {
      "command": "chain.yml private-exchange job (sudo uain-ci-run <workspace> private-exchange)",
      "suite": "private-exchange",
      "evidence": "Pinned Orchard proofs, Rust private tools and private network smoke"
    },
    "worker-signing-gate": {
      "command": "npm run check:worker in the web image build and services/pilot/test/worker-manifest.test.mjs: the frozen final release in public/worker/ verifies against manifest.sig",
      "evidence": "The retired client's final signed release (0.15.0) is served byte-identical; no further release can be signed"
    },
    "contracts-tests": {
      "command": "npm --prefix contracts test",
      "evidence": "Contract tests (no credentials)"
    },
    "press-tests": {
      "command": "node --test press/press.test.mjs",
      "evidence": "Press list tests"
    },
    "research-experiments": {
      "command": "python3 -m unittest discover -s research/covering-29-7-3 -p 'test_*.py'",
      "evidence": "Covering-design verifier unit tests (exploratory research code)"
    },
    "operations-tests": {
      "command": "sudo uain-ci-run <workspace> others",
      "suite": "others",
      "evidence": "Press, contracts and operations suite"
    },
    "runner-tests": {
      "command": "node --test runner/test/*.test.mjs",
      "evidence": "Agent runner tests"
    },
    "ci-harness": {
      "command": "python3 -m unittest discover -s ops/ci -p 'test_*.py' and sandbox rehearsal of the changed workflow or helper",
      "evidence": "Trusted workflow/helper review and failure injection"
    },
    "reverse-proxy": {
      "command": "python3 -m unittest discover -s apps/baink/deploy -p 'test_*routing.py'; bash ops/ci/verify-seo-routing.sh; nginx -t on the target host",
      "evidence": "Common reverse-proxy configuration for every routed service"
    }
  },
  "prose": {
    "globs": [
      "**/*.md",
      "**/*.pdf",
      "**/*.pptx",
      "docs/**/*.png",
      "docs/**/*.jpg",
      "docs/**/*.txt",
      "docs/**/*.log",
      "docs/**/*.html"
    ],
    "checks": ["docs-validation"],
    "dataGlobs": ["docs/**/*.json"],
    "dataChecks": ["docs-validation", "docs-data"],
    "executableGlobs": [
      "docs/**/*.mjs",
      "docs/**/*.js",
      "docs/**/*.cjs",
      "docs/**/*.ts",
      "docs/**/*.py",
      "docs/**/*.sh"
    ],
    "executableChecks": ["docs-executable"]
  },
  "executableDocs": [
    {
      "paths": ["docs/valuation/**"],
      "consumers": ["pilot"],
      "reason": "services/pilot/test/valuation.test.mjs and scripts/value-challenge.mjs read docs/valuation inputs"
    },
    {
      "paths": [
        "docs/baink/project-organizations-2026-11-06/kpi-amendments.json",
        "docs/baink/project-organizations-2026-11-06/bootstrap-reviewed/**"
      ],
      "consumers": ["organizations"],
      "reason": "services/project-organizations tests read the reviewed bootstrap directory and KPI amendments"
    }
  ],
  "policy": [
    {
      "paths": [
        "CLAUDE.md",
        "AGENTS.md",
        "apps/baink/CLAUDE.md",
        "apps/baink/AGENTS.md",
        "docs-crucial/**",
        "docs/smartmeet-executive-reporting.md"
      ],
      "governs": "*",
      "reason": "Repository-wide agent and release rules"
    },
    {
      "paths": ["docs/federation/**"],
      "governs": ["pilot", "native-chain", "baink-app", "organizations", "web"],
      "reason": "White paper and FAQ govern (decided 29 September 2026)"
    },
    {
      "paths": [
        "docs/baink/fund-manager-specification-*.md",
        "docs/baink/project-organizations-*/decisions.md"
      ],
      "governs": ["organizations", "baink-app"],
      "reason": "Fund Manager and project-organization decisions"
    },
    {
      "paths": ["docs/key-custody.md", "docs/recovery-financial.md"],
      "governs": ["holder", "reviewer", "operations"],
      "reason": "Custody and financial recovery procedure"
    }
  ],
  "components": {
    "web": {
      "description": "UAIN website (Vinext); image web",
      "sources": [
        "app/**",
        "components/**",
        "lib/**",
        "public/**",
        "scripts/**",
        "vite.config.ts",
        "next.config.ts",
        "tsconfig.json",
        "components.json",
        "Dockerfile",
        ".dockerignore"
      ],
      "exclude": ["public/worker/**", "**/*.md"],
      "lockfiles": [],
      "buildInputs": ["services/pilot/src/**"],
      "runtimeOutputs": ["dist/client/**", "dist/server/**"],
      "checks": ["site-build", "lint"],
      "releaseTarget": "web",
      "doctor": ["node", "deps:.", "deps:services/pilot"]
    },
    "pilot": {
      "description": "Connection server (TypeScript, PostgreSQL); image pilot",
      "sources": [
        "services/pilot/**",
        "services/retrieval/**",
        "research/reference/**"
      ],
      "exclude": [
        "services/pilot/package-lock.json",
        "services/pilot/package.json",
        "**/*.md"
      ],
      "lockfiles": [],
      "buildInputs": ["ops/chain/native-rpc-transport.mjs"],
      "runtimeOutputs": ["services/pilot/dist/**"],
      "checks": ["pilot-suite", "pilot-research", "pilot-reset", "site-build"],
      "releaseTarget": "pilot",
      "doctor": ["node", "deps:services/pilot", "postgres", "python3"]
    },
    "waitlist": {
      "description": "Waitlist dashboard; image waitlist",
      "sources": ["apps/waitlist-dashboard/**"],
      "exclude": ["**/*.md"],
      "lockfiles": ["apps/waitlist-dashboard/package-lock.json"],
      "buildInputs": [],
      "runtimeOutputs": [],
      "checks": ["waitlist-tests"],
      "releaseTarget": "waitlist",
      "doctor": ["node", "deps:apps/waitlist-dashboard", "postgres"]
    },
    "baink-app": {
      "description": "BAINK application: server, web, catalogue, integrations, BAINK ops and deploy packaging",
      "sources": ["apps/baink/**"],
      "exclude": [
        "apps/baink/review-broker/**",
        "apps/baink/review-service/**",
        "**/*.md"
      ],
      "lockfiles": ["apps/baink/package-lock.json"],
      "buildInputs": [
        "apps/baink/package.json",
        "apps/baink/vite.config.js",
        "apps/baink/index.html"
      ],
      "runtimeOutputs": ["apps/baink/dist/**", "output/baink-*/**"],
      "checks": ["baink-tests", "baink-deploy"],
      "releaseTarget": "baink-app",
      "disabledFeatures": [
        {
          "id": "native-project-pilot",
          "flag": "BAINK_NATIVE_PROJECT_PILOT_ENABLED",
          "default": "disabled",
          "paths": [
            "apps/baink/server/native-project-pilot.mjs",
            "apps/baink/server/native-project-access.mjs",
            "apps/baink/web/NativeProjectPilot.jsx",
            "apps/baink/web/native-project-pilot*.js",
            "apps/baink/web/native-project-pilot*.test.mjs"
          ],
          "reason": "Additive native project pilot ships disabled by default; a source change never enables it"
        }
      ],
      "doctor": ["node", "deps:apps/baink"]
    },
    "holder": {
      "description": "Private payment reviewer and review broker (apps/baink/review-broker; the Docker holder was retired 9 Nov 2026)",
      "sources": [
        "apps/baink/review-broker/**",
        "ops/custody/holder_release.py",
        "ops/custody/test_holder_release.py"
      ],
      "exclude": ["**/*.md"],
      "lockfiles": [],
