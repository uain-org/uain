  "contracts": [
    {
      "id": "native-codecs",
      "description": "BAINK wallet, holder and native codecs imported from chain/client by holder, BAINK web/server, review service and qualification",
      "paths": [
        "chain/client/**",
        "apps/baink/integrations/native-research-codec.mjs"
      ],
      "consumers": ["holder", "baink-app", "reviewer", "native-chain"],
      "checks": ["codec-contract", "qualification-tests"]
    },
    {
      "id": "baink-qualification-imports",
      "description": "BAINK modules imported by ops/qualification and ops/agents harnesses",
      "paths": [
        "apps/baink/server/native-enrol.mjs",
        "apps/baink/server/trade-payment.mjs",
        "apps/baink/server/native-financial-command.mjs",
        "apps/baink/server/central-earning-command.mjs",
        "apps/baink/web/central-earning.js",
        "apps/baink/web/identity.js",
        "apps/baink/web/native-financial.js"
      ],
      "consumers": ["operations"],
      "releaseConsumers": [],
      "checks": ["qualification-tests"],
      "includeConsumerChecks": false
    },
    {
      "id": "central-policy",
      "description": "Central earning and funding policy duplicated across Go, JavaScript and Python",
      "paths": [
        "chain/federation/central_*.go",
        "chain/federation/budgets.go",
        "apps/baink/server/funding-policy.mjs",
        "apps/baink/server/central-earning*.mjs",
        "apps/baink/server/central-budget.mjs",
        "services/fund-manager/src/**",
        "ops/custody/central_*.py",
        "ops/custody/project_organizations.py"
      ],
      "consumers": ["native-chain", "baink-app", "reviewer", "organizations"],
      "checks": ["central-policy-cross"],
      "includeConsumerChecks": false,
      "releaseConsumers": []
    },
    {
      "id": "private-payment-source-pins",
      "description": "Source files pinned by ops/custody/private_payment_service.py",
      "paths": [
        "apps/baink/review-broker/reviewer-worker.mjs",
        "apps/baink/server/native-payments.mjs",
        "apps/baink/server/native-financial-command.mjs"
      ],
      "consumers": ["holder", "baink-app", "operations"],
      "checks": ["custody-python", "holder-tests"]
    },
    {
