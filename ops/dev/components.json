        "ops/custody/test_public_review_dispatch.py"
      ],
      "exclude": ["**/*.md"],
      "lockfiles": [],
      "buildInputs": [],
      "runtimeOutputs": [],
      "checks": ["reviewer-tests"],
      "releaseTarget": "reviewer",
      "doctor": ["node", "python3", "flock"]
    },
    "organizations": {
