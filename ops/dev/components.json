      "description": "apps/baink/server/survey-templates.json is generated by services/project-organizations/ops/survey-templates.mjs",
      "paths": [
        "services/project-organizations/ops/survey-templates.mjs",
        "apps/baink/server/survey-templates.json"
      ],
      "consumers": ["organizations", "baink-app"],
      "checks": ["organizations-tests", "baink-tests"]
    },
    {
      "id": "organizations-compute-budget",
      "description": "BAINK project manager worker imports the organizations compute budget",
      "paths": ["services/project-organizations/src/compute-budget.mjs"],
      "consumers": ["baink-app", "organizations"],
      "checks": ["baink-tests"]
    },
    {
      "id": "fund-round-golden",
      "description": "Golden vectors for the later funding rounds: the manager stage (JavaScript) writes fund batches and the root driver ops/custody/manager_stage.py (Python) re-derives their digests",
      "paths": ["fixtures/contracts/fund-round.json"],
      "consumers": ["organizations", "operations"],
      "checks": ["organizations-tests", "custody-python"]
    },
    {
      "id": "admin-wire",
      "description": "Admin wire contract consumed by the separate super-admin repository (deployed outside this repository)",
      "paths": [
        "services/pilot/src/admin/**",
        "services/pilot/test/admin-*.test.mjs",
        "docs/admin-connection.md",
        "ADMIN_HANDOFF.md"
      ],
      "consumers": ["pilot"],
      "checks": ["admin-contract"],
      "external": "Separate super-admin repository; do not assume this repository controls its deployment",
      "releaseConsumers": []
    },
    {
      "id": "reverse-proxy",
      "description": "Common reverse-proxy and front-door configuration",
      "paths": [
        "ops/nginx/**",
        "deploy/k8s/production/front-door*.conf",
        "deploy/k8s/staging/front-door.conf",
        "apps/baink/deploy/*.conf",
        "apps/baink/deploy/install-*-routing.py",
        "apps/baink/deploy/fix-payment-list-routing.py",
        "apps/baink/deploy/nginx-fixture-isolation.py"
      ],
      "consumers": ["web", "pilot", "waitlist", "baink-app"],
      "checks": ["reverse-proxy"]
    },
    {
      "id": "pilot-native-rpc",
      "description": "ops/chain/native-rpc-transport.mjs is copied into the pilot image",
      "paths": ["ops/chain/native-rpc-transport.mjs"],
      "consumers": ["pilot", "native-chain"],
      "checks": ["pilot-suite"]
    },
    {
      "id": "root-dependencies",
      "description": "Root package manifest and lockfile: website build and the repository-wide linter",
      "paths": [
        "package.json",
        "package-lock.json",
        ".oxlintrc.json",
        ".oxfmtrc.json"
      ],
      "consumers": ["web", "worker"],
      "checks": ["lint", "dev-tools"]
    },
    {
      "id": "pilot-dependencies",
      "description": "Pilot lockfile: installed by the pilot image and the site build (build:pilot)",
      "paths": [
        "services/pilot/package.json",
        "services/pilot/package-lock.json"
      ],
      "consumers": ["pilot", "web"],
      "checks": []
    },
    {
      "id": "chain-dependencies",
      "description": "Chain Go module and Node lockfile: both the native-chain and the Orchard-tagged private-exchange builds compile every Go package",
      "paths": [
        "chain/go.mod",
        "chain/go.sum",
        "chain/package.json",
        "chain/package-lock.json",
        "chain/**/*.go"
      ],
      "consumers": ["native-chain", "private-exchange"],
      "checks": []
    },
    {
      "id": "ci-harness",
      "description": "Workflows and the CI launcher/container suite run every suite; a change re-qualifies all of them",
      "paths": [".github/workflows/**", "ops/ci/**", "ops/remote-test/run.sh"],
      "consumers": ["operations"],
      "checks": ["ci-harness"],
      "selectsAllChecks": true
    },
    {
      "id": "dev-tools",
      "description": "This component map and the development tools",
      "paths": ["ops/dev/**"],
      "consumers": ["operations"],
      "releaseConsumers": [],
      "checks": ["dev-tools"],
      "includeConsumerChecks": false
    }
  ]
}
