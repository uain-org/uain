[Unit]
Description=Refresh and verify encrypted UAIN custody backups
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/uain-custody refresh
ExecStart=/usr/local/sbin/uain-custody backup
Nice=10
IOSchedulingClass=idle
MemoryMax=768M
CPUQuota=100%
TimeoutStartSec=600
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/uain-custody /run/lock /dev/shm
