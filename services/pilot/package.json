{
  "name": "uain-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UAIN connection server: the endpoint AI systems enrol through, and the log that measures whether they do.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.boundaries.json",
    "start": "node dist/src/api/server.js",
    "dev": "npm run build && node --watch dist/src/api/server.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "npm run typecheck && npm run build && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "jose": "6.2.12",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
