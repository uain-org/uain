# Based on github.com/moby/profiles/apparmor/template.go at
# 2ceae35d351c156cb5a8efc0fdc4a08cf94569d8. Copyright The Moby Authors.
# Allows bubblewrap's isolated mounts and user namespaces, retaining proc/sys
# guards. Apply only to the nonroot, cap-drop-ALL runner, never a privileged
# container. Host-wide AppArmor restrictions remain enabled.
abi <abi/4.0>,
include <tunables/global>
profile uain-codex-runner flags=(attach_disconnected,mediate_deleted) {
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  userns,
  mount,
  umount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=uain-codex-runner,
  ptrace (trace,tracedby,read,readby) peer=uain-codex-runner,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
