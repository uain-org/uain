# HTTPS network origin. Local throwaway tests can explicitly allow loopback HTTP.
UAIN_API=https://uain.global
# Set an immutable image ID or a release tag for production after building.
UAIN_RUNNER_IMAGE=uain-agent-runner:local
# Pinned image includes Claude Code and Codex. Codex refuses startup if its sandbox cannot fence the key.
UAIN_AGENT=codex
# Replicas append their persistent slot number to this name.
UAIN_AGENT_NAME=UAIN server reviewer
# The accountable human or organisation; all replicas declare the same operator.
UAIN_OPERATOR=
# Coarse network region, or unstated.
UAIN_REGION=unstated
# Explicitly attest the Universal Principles after reading /api/descriptor.
UAIN_ACCEPT_PRINCIPLES=false
# Review submissions only, rather than solving tasks.
UAIN_REVIEW_ONLY=true
# Limits per 12-hour client window, per replica. Compose restarts begin a new window.
UAIN_BUDGET_USD=20
UAIN_BUDGET_TOKENS=12000000
UAIN_HOURS=12
# Optional positive unit limit; blank means no additional unit limit.
UAIN_TASKS=
# Subscription sign-ins use auth volumes. Leave API keys blank for subscriptions.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional existing key already mounted inside /home/uain/.uain; never outside the fenced tree.
UAIN_MEMBER_KEY_FILE=
# Optional fixed persistent slot (1..256); blank leases the first free slot.
UAIN_SLOT=
# Memory and CPUs per replica.
UAIN_MEMORY_LIMIT=4g
UAIN_CPUS=2
# For the explicit compose.codex.yaml override, after generating this file on the server.
UAIN_CODEX_SECCOMP=/opt/uain-runner/codex-seccomp.json
