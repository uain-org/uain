+/** Foreground read-only refresh. Abort is advisory: keep ownership until an
+ * in-flight promise settles, even if its transport ignores cancellation. */
+export function startProjectReviewRefresh({read,onError=()=>{},visibility=globalThis.document,setTimer=globalThis.setTimeout,clearTimer=globalThis.clearTimeout,intervalMs=30000}) {
+ let stopped=false,active=null,timer=null,resume=false,hasValue=false;
+ const visible=()=>!visibility?.hidden;
+ const clear=()=>{if(timer!==null){clearTimer(timer);timer=null;}};
+ const run=async()=>{
+  if(stopped||!visible())return;
+  if(active){resume=true;return;}
+  clear();resume=false;const controller=new AbortController();active=controller;
+  try {await read(controller.signal);if(!stopped&&!controller.signal.aborted)hasValue=true;}
+  catch(error){if(!stopped&&!controller.signal.aborted)onError(error,!hasValue);}
+  finally {active=null;if(!stopped&&visible()){if(resume){resume=false;void run();}else timer=setTimer(()=>{timer=null;void run();},intervalMs);}}
+ };
+ const changed=()=>{clear();if(!visible()){active?.abort();return;}if(active){resume=true;return;}void run();};
+ visibility?.addEventListener?.('visibilitychange',changed);
+ void run();
+ return()=>{if(stopped)return;stopped=true;clear();active?.abort();visibility?.removeEventListener?.('visibilitychange',changed);};
+}
