+#!/usr/bin/env node
+/** Local OS-operator tool only. Reads one bounded review from stdin; no network,
+ * private source fetch, key handling, scientific acceptance or financial writes. */
+import {lstat,realpath,open} from 'node:fs/promises';
+import {constants} from 'node:fs';
+import {resolve,dirname} from 'node:path';
+import {userInfo} from 'node:os';
+import {DatabaseSync} from 'node:sqlite';
+import {createProjectManagement} from '../../apps/baink/server/project-management.mjs';
+const check=value=>{if(!value)throw Error('refused');};
+let service;
+try {
+ const args=process.argv.slice(2);check(args.length===2&&args[0]==='--database'&&resolve(args[1])===args[1]);
+ const path=args[1],uid=process.getuid();check(Number.isInteger(uid));
+ check(await realpath(path)===path);
+ for(let p=dirname(path);;p=dirname(p)){const s=await lstat(p);check(s.isDirectory()&&!s.isSymbolicLink()&&[0,uid].includes(s.uid)&&(!(s.mode&0o022)||(s.uid===0&&(s.mode&0o1000))));if(dirname(p)===p)break;}
+ const s=await lstat(path);check(s.isFile()&&!s.isSymbolicLink()&&s.uid===uid&&s.nlink===1&&!(s.mode&0o077));
+ for(const suffix of ['-wal','-shm'])try{const side=await lstat(path+suffix);check(side.isFile()&&!side.isSymbolicLink()&&side.uid===uid&&side.nlink===1&&!(side.mode&0o077));}catch(e){if(e.code!=='ENOENT')throw e;}
+ const f=await open(path,constants.O_RDONLY|constants.O_NOFOLLOW);try{const header=Buffer.alloc(16);check((await f.read(header,0,16,0)).bytesRead===16&&header.equals(Buffer.from('SQLite format 3\0')));}finally{await f.close();}
+ const existing=new DatabaseSync(path,{readOnly:true});try{for(const [table,required] of [['projects',['id','source','source_digest']],['evidence',['owner','project_id','request_id','payload','created_at']]]){const columns=existing.prepare('PRAGMA table_info('+table+')').all().map(row=>row.name);check(required.every(name=>columns.includes(name)));}}finally{existing.close();}
+ let size=0;const chunks=[];for await(const chunk of process.stdin){size+=chunk.length;check(size<=65536);chunks.push(chunk);}const input=JSON.parse(Buffer.concat(chunks).toString('utf8'));
+ // Named operator attribution is bound to the authenticated local OS identity.
+ check(input.reviewerOperator===userInfo().username);
+ service=createProjectManagement({path,enabled:true,catalogue:{available:true,list:()=>({total:0,projects:[]})}});
+ const result=service.recordPreparationReview(input);
+ console.log(JSON.stringify({created:result.created,eventId:result.event.eventId,kind:result.event.kind,scientificAcceptance:false,rewardGranted:false,notificationStatus:result.event.notificationStatus}));
+} catch {console.error('Preparation review refused; database, operator, existing evidence or review binding did not validate.');process.exitCode=1;} finally {service?.close();}
