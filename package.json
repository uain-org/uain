{
  "name": "uain-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "bash ops/check.sh",
    "setup:local-db": "node --env-file=.env services/pilot/scripts/setup-local-test.mjs",
    "build:pilot": "npm --prefix services/pilot run typecheck && npm --prefix services/pilot run build",
    "worker:openrouter": "npm run build:pilot && node --env-file=.env services/pilot/scripts/run-openrouter.mjs",
    "backup:drill": "npm run build:pilot && node --env-file=.env services/pilot/scripts/backup-drill.mjs",
    "check:launch": "npm run build:pilot && node services/pilot/scripts/launch-check.mjs",
    "dev:pilot": "npm run build:pilot && node --env-file=.env services/pilot/dist/src/api/server.js",
    "test:pilot": "npm run build:pilot && node --env-file=.env --test --test-concurrency=1 services/pilot/test/*.test.mjs",
    "test:organizations": "node --test services/project-organizations/test/*.test.mjs services/fund-manager/test/*.test.mjs && python3 -m unittest discover -s ops/custody -p 'test_project_organizations.py'",
    "dev": "node scripts/copy-cesium.mjs && vinext dev",
    "build": "npm run build:pilot && npm run build:web && npm run check:worker",
    "build:web": "node scripts/copy-cesium.mjs && vinext build && node scripts/record-frame.mjs dist/client && node ops/docs/build-id.mjs uain-web dist/client/build.json && npm run check:social-previews && node scripts/check-owned-discovery.mjs",
    "check:worker": "node ops/ci-scope/verify-worker-bundle.mjs dist/client/worker",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "check:social-previews": "node --experimental-strip-types scripts/check-social-previews.mjs",
    "release:plan": "node ops/release/cli.mjs plan",
    "release:verify": "node ops/release/cli.mjs verify",
    "release:promote": "node ops/release/cli.mjs promote",
    "release:status": "node ops/release/cli.mjs status",
    "release:rollback": "node ops/release/cli.mjs rollback",
    "doctor": "node ops/dev/doctor.mjs",
    "impact": "node ops/dev/impact.mjs",
    "timings": "node ops/dev/timings.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "cesium": "^1.146.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "globe.gl": "^2.46.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "satellite.js": "^6.0.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "oxfmt": "0.76.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
